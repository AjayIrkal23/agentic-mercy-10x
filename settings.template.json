{
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 900000,
  "contextWindow": 1000000,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-session-driver@superpowers-marketplace": true,
    "elements-of-style@superpowers-marketplace": true,
    "firecrawl@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "nateherk-design@nateherk": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers-lab@superpowers-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "high",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "MCP_TIMEOUT": "30000",
    "RETICLE_TELEMETRY": "0",
    "VALIDATION_CLIENT": "sdk",
    "TDD_GUARD_MODEL_VERSION": "sonnet",
    "PONYTAIL_SUBAGENT_MATCHER": "^(implementation-engineer|backend-implementor-specialist|frontend-implementor-specialist|frontend-uiux-designer|integrator-specialist|refactor-specialist|test-author|deadcode-reaper|docs-sync-agent)$"
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "forrestchang/andrej-karpathy-skills",
        "source": "github"
      }
    },
    "nateherk": {
      "autoUpdate": true,
      "source": {
        "repo": "nateherkai/scroll-craft",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": true,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "autoUpdate": true,
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|Agent|Task|Workflow|Skill|mcp__lean.ctx__.*|mcp__jcodemunch__.*",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py pre-tool-use", "timeout": 30, "statusMessage": "dispatch: gates"}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Agent|Task|Skill|mcp__jcodemunch__.*|mcp__semgrep__.*",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py post-tool-use", "timeout": 25}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Edit|Write|Bash",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py post-tool-use-failure", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/prompt_router/router.py", "timeout": 15}]}
    ],
    "SessionStart": [
      {"matcher": ".*",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py session-start", "timeout": 45, "statusMessage": "session bootstrap"}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py subagent-start", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py subagent-stop", "timeout": 10}]}
    ],
    "TeammateIdle": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py teammate-idle", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py stop", "timeout": 30, "statusMessage": "completion gates"}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py pre-compact", "timeout": 10}]}
    ],
    "PostCompact": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py post-compact", "timeout": 10}]}
    ],
    "ConfigChange": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py config-change", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py session-end", "timeout": 10}]}
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": []
  },
  "remoteControlAtStartup": true,
  "skillListingBudgetFraction": 0.3,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
