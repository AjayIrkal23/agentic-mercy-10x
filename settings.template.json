{
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 900000,
  "cleanupPeriodDays": 30,
  "contextWindow": 1000000,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-session-driver@superpowers-marketplace": false,
    "egm@egm": true,
    "elements-of-style@superpowers-marketplace": true,
    "firecrawl@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "nateherk-design@nateherk": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers-lab@superpowers-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "tokeneconomizer@tokeneconomizer": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_PLUGIN_DIRS": "{{MOD_DIRS}}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4",
    "CLAUDE_CODE_TOOL_MEMORY_LIMIT": "6G",
    "CLAUDE_CODE_TOOL_MEMORY_CGROUP_EXCLUDE": "all-new",
    "CLAUDE_CODE_MAX_MCP_DESCRIPTION_LENGTH": "4000",
    "MCP_TIMEOUT": "30000",
    "RETICLE_TELEMETRY": "0",
    "VALIDATION_CLIENT": "sdk",
    "TDD_GUARD_MODEL_VERSION": "claude-sonnet-5-5",
    "EIO_BACKEND": "posix",
    "PONYTAIL_SUBAGENT_MATCHER": "^(implementation-engineer|backend-implementor-specialist|frontend-implementor-specialist|frontend-uiux-designer|integrator-specialist|refactor-specialist|test-author|deadcode-reaper|docs-sync-agent)$"
  },
  "extraKnownMarketplaces": {
    "egm": {
      "autoUpdate": false,
      "source": {
        "repo": "google/elephant-goldfish-model",
        "source": "github"
      }
    },
    "karpathy-skills": {
      "autoUpdate": false,
      "source": {
        "repo": "forrestchang/andrej-karpathy-skills",
        "source": "github"
      }
    },
    "nateherk": {
      "autoUpdate": false,
      "source": {
        "repo": "nateherkai/scroll-craft",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": false,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "autoUpdate": true,
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "maxEffortLevel": "xhigh",
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|Agent|Task|Workflow|mcp__lean.ctx__(ctx_read|ctx_search|ctx_patch|ctx_shell|shell|ctx_call)|mcp__claude_ai_.*|mcp__plugin_.*|mcp__github__.*|mcp__playwright__browser_navigate",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py pre-tool-use", "timeout": 30, "statusMessage": "dispatch: gates"}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Agent|Task|Skill|mcp__jcodemunch__.*|mcp__semgrep__.*|mcp__lean.ctx__(ctx_patch|ctx_shell|shell|ctx_call)",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py post-tool-use", "timeout": 25}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Edit|Write|Bash|PowerShell|mcp__.*",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py post-tool-use-failure", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py user-prompt-submit", "timeout": 15}]}
    ],
    "SessionStart": [
      {"matcher": ".*",
       "hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py session-start", "timeout": 45, "statusMessage": "session bootstrap"}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py subagent-start", "timeout": 5}]}
    ],
    "TeammateIdle": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py teammate-idle", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py stop", "timeout": 40, "statusMessage": "completion gates"}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py stop-failure", "timeout": 5}]}
    ],
    "InstructionsLoaded": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py instructions-loaded", "timeout": 3}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py pre-compact", "timeout": 10}]}
    ],
    "ConfigChange": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py config-change", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "{{PYTHON}} {{CLAUDE_DIR}}/hooks/dispatch.py session-end", "timeout": 10}]}
    ]
  },
  "outputStyle": "caveman",
  "skillOverrides": {
    "invoke-audit": "name-only",
    "invoke-clean": "name-only",
    "invoke-debug": "name-only",
    "invoke-design": "name-only",
    "invoke-docs": "name-only",
    "invoke-impl": "name-only",
    "invoke-plan": "name-only",
    "invoke-refactor": "name-only",
    "invoke-review": "name-only",
    "invoke-security": "name-only",
    "invoke-session": "name-only",
    "invoke-spec": "name-only",
    "invoke-status": "name-only",
    "invoke-test": "name-only",
    "invoke-update": "name-only",
    "invoke-verify": "name-only",
    "mmx-cli": "name-only",
    "workflow-audit": "name-only"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/plugins/cache/egm/egm/*/agents/**)",
      "Read(~/.claude/plugins/cache/egm/egm/*/docs/**)",
      "Read(~/.claude/plugins/cache/egm/egm/*/resources/**)",
      "Read(~/.claude/plugins/cache/egm/egm/*/skills/**)"
    ],
    "defaultMode": "bypassPermissions",
    "deny": []
  },
  "remoteControlAtStartup": true,
  "skillListingBudgetFraction": 0.3,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {"type": "command", "command": "{{PYTHON_EXE}} {{CLAUDE_DIR}}/scripts/statusline.py", "padding": 0, "refreshInterval": 10},
  "theme": "dark"
}
