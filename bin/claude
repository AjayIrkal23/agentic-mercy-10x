#!/usr/bin/env bash
# agentic-mercy oomguard launcher: every interactive `claude` runs in its own systemd scope that
# survives one OOM victim, with RAM-derived agent caps. Subcommands (`claude plugin test`, `claude mcp
# list`), hook helpers (-p/--print/--bare), nested launches (CLAUDECODE / CLAUDE_WORKBENCH_SCOPE) and hosts
# without a user bus exec the real binary untouched. Design: docs/OOM-GUARD.md (layer L1).
set -u

self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
is_wrapper() { head -c 512 "$1" 2>/dev/null | grep -q 'agentic-mercy oomguard launcher'; }

real=${CLAUDE_REAL_BIN:-}
if [ -z "$real" ]; then
  while IFS= read -r cand; do
    [ -z "$cand" ] && continue
    resolved=$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")
    [ "$resolved" = "$self" ] && continue
    is_wrapper "$resolved" && continue   # another copy of this launcher: never exec ourselves
    real=$cand
    break
  done < <(type -aP claude 2>/dev/null)
fi
if [ -z "$real" ] || [ ! -x "$real" ]; then
  echo "claude: real binary not found (set CLAUDE_REAL_BIN)" >&2
  exit 127
fi

unattended=0
bare=0
has_settings=0
has_model=0
for a in "$@"; do
  case "$a" in
    -p|--print) unattended=1 ;;
    --bare) bare=1 ;;
    --settings|--settings=*) has_settings=1 ;;
    --model|--model=*) has_model=1 ;;
  esac
done
subcmd=0
case "${1:-}" in  # subcommands take no session model (`claude --help` Commands list, 2.1.3xx)
  agents|attach|auth|auto-mode|config|doctor|gateway|import|install|kill|logs|mcp|migrate-installer|plugin|plugins|purge|respawn|rm|setup-token|stop|ultrareview|update|upgrade) has_model=1; subcmd=1 ;;
esac
if [ "$unattended" = 1 ]; then
  export CLAUDE_WORKBENCH_UNATTENDED=1
fi
state="${CLAUDE_HOOK_STATE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/state}"

# tier main model (docs/MODEL-ROUTING.md §6), interactive launches only, when nothing else chose one:
# no --model, no ANTHROPIC_MODEL, no saved /model pick in settings.json. Claude Code deletes a
# user-settings `model` whenever the org default changes, so that key is not a reliable carrier.
tier_model=""
if [ "$has_model" = 0 ] && [ "$unattended" = 0 ] && [ "$bare" = 0 ] && [ -z "${ANTHROPIC_MODEL:-}" ] \
   && [ -z "${CLAUDECODE:-}" ] && [ "${CLAUDE_WORKBENCH_SCOPE:-}" != 1 ]; then
  cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  # a /login or `claude auth login` since the last SessionStart rewrote .credentials.json after
  # state/plan-tier.json: re-detect now (lib/plan_tier, ~30 ms), else a stale tier picks the model
  detect="$(dirname "$self")/../hooks/plan-tier-detect.py"
  if [ -f "$cfg/.credentials.json" ] && [ -f "$detect" ] && ! [ "$state/plan-tier.json" -nt "$cfg/.credentials.json" ]; then
    python3 "$detect" --state "$state/plan-tier.json" --quiet >/dev/null 2>&1 || true
  fi
  ucfg=$(cat "$cfg/settings.json" 2>/dev/null || true)
  # --model outranks every settings file: a project's own model pick (cwd or repo root) stops the injection
  for d in "$PWD" "$(git rev-parse --show-toplevel 2>/dev/null || true)"; do
    [ -n "$d" ] && ucfg+=$(cat "$d/.claude/settings.json" "$d/.claude/settings.local.json" 2>/dev/null || true)
  done
  tier=$(cat "$state/plan-tier.json" 2>/dev/null || true)
  if ! [[ $ucfg =~ \"model\"[[:space:]]*: ]] && [[ $tier =~ \"main\":[[:space:]]*\"([a-z0-9.-]+)\" ]]; then
    tier_model=${BASH_REMATCH[1]}
  fi
fi
if [ "${CLAUDE_LAUNCHER_PRINT_ARGV:-}" = 1 ]; then  # the doctor's probe: the decision, no side effects
  printf '%s\n' "$real" ${tier_model:+--model "$tier_model"} "$@"
  exit 0
fi

passthrough=0
if [ "$subcmd" = 1 ] || [ "$unattended" = 1 ] || [ "$bare" = 1 ]; then  # a subcommand is not a session (F3)
  passthrough=1
elif [ -n "${CLAUDECODE:-}" ] || [ "${CLAUDE_WORKBENCH_SCOPE:-}" = 1 ]; then
  passthrough=1
elif [ ! -e "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
  passthrough=1
elif ! command -v systemd-run >/dev/null 2>&1; then
  passthrough=1
fi
if [ "$passthrough" = 1 ]; then
  exec "$real" ${tier_model:+--model "$tier_model"} "$@"
fi

# --- launch caps from MemAvailable (the same /proc field as hooks/lib/platform.mem_probe) ---
# CLAUDE_LAUNCHER_MEMINFO: test seam (a fake meminfo file)
meminfo=${CLAUDE_LAUNCHER_MEMINFO:-/proc/meminfo}
avail_kb=0; total_kb=0
if [ -r "$meminfo" ]; then
  while IFS=': ' read -r key val _; do
    case "$key" in MemAvailable) avail_kb=$val ;; MemTotal) total_kb=$val ;; esac
  done < "$meminfo"
fi
case "$avail_kb" in ''|*[!0-9]*) avail_kb=0 ;; esac
case "$total_kb" in ''|*[!0-9]*) total_kb=0 ;; esac
avail_gib=$(( avail_kb / 1048576 ))
clamp() {
  local v=$1 lo=$2 hi=$3
  [ "$v" -lt "$lo" ] && v=$lo
  [ "$v" -gt "$hi" ] && v=$hi
  printf '%s' "$v"
}
wf=$(clamp $(( avail_gib / 3 )) 1 8)
sub=$(clamp $(( avail_gib / 2 )) 2 6)
export CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS="${CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS:-$wf}"
export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS="${CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS:-$sub}"
if [ "$avail_gib" -lt 8 ]; then size=small; elif [ "$avail_gib" -lt 16 ]; then size=medium; else size=large; fi

mkdir -p "$state/launch-caps" 2>/dev/null || true
printf '{"mem_available_mb":%s,"workflow_agents":%s,"subagents":%s,"size_guideline":"%s","ts":%(%s)T}\n' \
  "$(( avail_kb / 1024 ))" "$CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS" "$CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS" \
  "$size" -1 > "$state/launch-caps/$$.json" 2>/dev/null || true

set -- "$real" ${tier_model:+--model "$tier_model"} "$@"
if [ "$has_settings" = 0 ]; then
  sfile="$state/launch-settings-$$.json"
  # the launch-settings env block beats the user settings file's env, so the RAM-derived caps are in force
  if printf '{"workflowSizeGuideline":"%s","env":{"CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS":"%s","CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS":"%s"}}\n' \
       "$size" "$CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS" "$CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS" > "$sfile" 2>/dev/null; then
    set -- "$real" --settings "$sfile" "${@:2}"
  fi
fi

# scope MemoryHigh: CLAUDE_SCOPE_MEMORY_HIGH > oomguard.local.json memory_high > MemTotal minus 4 GiB for the
# desktop, never below half of MemTotal (hooks/lib/oomguard_config.memory_cap_mb; bin/claude-tmux repeats it)
mh=${CLAUDE_SCOPE_MEMORY_HIGH:-}
if [ -z "$mh" ]; then
  ocfg=$(cat "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/oomguard.local.json" 2>/dev/null || true)
  if [[ $ocfg =~ \"memory_high\"[[:space:]]*:[[:space:]]*\"([0-9]+[KMGT]?)\" ]]; then mh=${BASH_REMATCH[1]}; fi
fi
if [ -z "$mh" ]; then
  total_mb=$(( total_kb / 1024 ))
  cap_mb=$(( total_mb - 4096 ))
  [ "$cap_mb" -lt $(( total_mb / 2 )) ] && cap_mb=$(( total_mb / 2 ))
  if [ "$total_mb" -le 0 ]; then mh=12G; else mh="${cap_mb}M"; fi
fi

export CLAUDE_WORKBENCH_SCOPE=1
# --scope runs the command in this environment, so the exported caps reach the real binary.
exec systemd-run --user --scope --quiet --collect --unit "claude-$$" \
  -p OOMPolicy=continue -p ManagedOOMPreference=avoid -p "MemoryHigh=$mh" -- "$@"
