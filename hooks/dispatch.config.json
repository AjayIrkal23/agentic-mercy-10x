      {"id": "gateguard-ack", "type": "exec", "tools": "Write|Edit|MultiEdit", "cmd": ["{PY}", "{HOOKS}/gateguard-write-gate.py", "post-tool-use"], "timeout_ms": 3000, "enabled": true, "_note": "B1-08: acknowledge a gateguard ask only after the write ran (a declined ask asks again)"},
