      {"id": "state-cleanup", "type": "exec", "async": true, "cmd": ["{PY}", "{HOOKS}/tools/state-cleanup.py"], "timeout_ms": 5000, "enabled": true},
      {"id": "session-start-aggregator", "type": "advisory", "cmd": ["{PY}", "{HOOKS}/session-start-aggregator.py"], "timeout_ms": 30000, "priority": 0, "enabled": true},
      {"id": "memory-load-on-start", "type": "advisory", "cmd": ["{PY}", "{HOOKS}/memory-load-on-start.py"], "timeout_ms": 5000, "priority": 1, "enabled": true},
      {"id": "session-lifecycle-start", "type": "advisory", "cmd": ["{PY}", "{HOOKS}/session-lifecycle.py", "session-start"], "timeout_ms": 10000, "priority": 1, "enabled": true},
      {"id": "ponytail-session", "type": "advisory", "cmd": ["{PY}", "{HOOKS}/ponytail-caveman-guard.py", "session-start"], "timeout_ms": 5000, "priority": 2, "enabled": true},
      {"id": "skills-index-guard", "type": "exec", "async": true, "cmd": ["{PY}", "{HOOKS}/build-skills-index.py", "--hook"], "timeout_ms": 10000, "enabled": true, "_note": "rebuilds skills-index.json when any SKILL.md is newer (mtime no-op otherwise)"},
      {"id": "selfheal-daily", "type": "exec", "async": true, "cmd": ["{PY}", "{HOOKS}/tools/selfheal-daily.py"], "timeout_ms": 1800000, "enabled": true, "_note": "autonomy WP-D: once a day, locked, detached (never waited on; the timeout is only the script's own 30 min budget): MCP pin reconcile, missing CLIs, stale settings re-render, vendored DRIFT; writes state/selfheal-daily.json for the aggregator"}
    ],
    "pre-tool-use": [
      {"id": "dangerous-bash-gate", "type": "gate", "tools": "Bash", "cmd": ["{PY}", "{HOOKS}/dangerous-bash-gate.py"], "timeout_ms": 5000, "enabled": true, "_order": "DANGER FIRST"},
      {"id": "connector-ask-gate", "type": "gate", "tools": "mcp__claude_ai_.*|mcp__plugin_.*", "cmd": ["{PY}", "{HOOKS}/connector-ask-gate.py"], "timeout_ms": 3000, "enabled": true, "_note": "G-02: ask (never deny) for delete/trash/share/send/mutation verbs on claude.ai connector and plugin MCP tools"},
