      {"id": "jcm-mcp-used", "type": "exec", "tools": "mcp__jcodemunch__.*", "cmd": ["{PY}", "{HOOKS}/jcodemunch-enforce.py", "mcp-used"], "timeout_ms": 3000, "enabled": true},
      {"id": "mcp-post-hints", "type": "advisory", "tools": "Write|Edit|MultiEdit|NotebookEdit", "cmd": ["{PY}", "{HOOKS}/mcp-post-hints.py"], "timeout_ms": 3000, "priority": 1, "enabled": true, "_note": "call-X-now MCP hints after writes: semgrep (security files), context7 (new imports), reticle/playwright (FE edit + app running), postgres-patterns (migrations), jcodemunch blast radius (>3 files); deduped per session"}
